{
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.118.0",
    "zod": "npm:zod@4.6.7"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check *.ts",
    "test": "deno test --coverage=coverage handler.test.ts rateLimiter.test.ts",
    "test:integration": "deno test --allow-env --allow-net integration.test.ts"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true
  }
}
